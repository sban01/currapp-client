# Copy to .env and fill in. Microsoft SSO only.

# Azure AD App Registration (must match the AZURE_* values in currapp-api/.env).
VITE_CLIENT_ID=<client ID>
VITE_AUTHORITY=https://login.microsoftonline.com/<tenant ID>

# Must exactly match one of the app registration's registered redirect URIs
# (these don't follow the app's own /currapp base path — they're whatever was
# registered in Azure AD). The two currently registered:
#   dev:  http://localhost:3000/auth
#   prod: https://cai.sgu.edu/app
VITE_REDIRECT_URI=http://localhost:3000/auth

# API base URL — same-origin proxy prefix in dev; set to the full URL in prod.
VITE_API_BASE_URL=/currapp-api

# --- Query caching ----------------------------------------------------------
# Freshness is driven by the API's le_<group> timestamps, not by these timers:
# the client polls GET /reports/lastedit and refetches only the group whose
# source data actually changed. The settings below are the backstop for a
# missed poll.

# Query cache lifetime in HOURS — applied to BOTH staleTime and gcTime.
VITE_STALE_TIME_HOURS=24

# How often to poll GET /reports/lastedit, in ms (1 hour). Independent of the
# access token lifetime — this is about data freshness, not sessions.
VITE_LASTEDIT_POLL_MS=3600000
